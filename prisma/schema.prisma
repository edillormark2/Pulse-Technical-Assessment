// Pulse — coordination store only. Nothing here is durable user data:
// rows are deleted on leave, on staleness, or after a signal is delivered.
// Chat text and video are NOT modeled — they ride WebRTC peer-to-peer and
// never reach the server.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Presence {
  // Public id, generated by the server. Everyone online sees it, so it is
  // never a credential.
  id        String   @id @default(uuid())
  // SHA-256 of the session's secret token. Only the owner's tab holds the
  // token; a copy of this table cannot be replayed as anyone.
  tokenHash String   @unique
  // Already privacy-offset on the device: the raw location never leaves it.
  lat       Float
  lng       Float
  // The owner's own clock offset from UTC in minutes (e.g. 480 for UTC+8), so
  // others can read their local hour. Coarser than the dot it belongs to.
  utcOffset Int?
  lastSeen  DateTime
  createdAt DateTime @default(now())

  call   CallMember?  @relation("member")
  peerOf CallMember[] @relation("peer")
  inbox  Signal[]

  @@index([lastSeen])
}

/// One row per person in a call, ringing or connected. The primary key makes
/// "one call at a time" a database guarantee: starting a call inserts both
/// people's rows in a single statement, which fails whole if either is taken.
/// Deleting either person's presence ends the call for both.
model CallMember {
  personId  String   @id
  peerId    String
  role      String // caller | callee (both caller when they asked each other)
  state     String // ringing | connected
  createdAt DateTime @default(now())

  person Presence @relation("member", fields: [personId], references: [id], onDelete: Cascade)
  peer   Presence @relation("peer", fields: [peerId], references: [id], onDelete: Cascade)

  @@index([peerId])
}

model Signal {
  // Mailbox for connection requests + WebRTC signaling only.
  id        String   @id @default(uuid())
  toId      String // recipient's public id
  fromId    String // sender's public id, set by the server from the token
  type      String // request | accept | decline | offer | answer | ice | end
  payload   String? // JSON string (SDP / ICE candidate)
  createdAt DateTime @default(now())

  to Presence @relation(fields: [toId], references: [id], onDelete: Cascade)

  @@index([toId, createdAt])
}

/// Fixed-window counters for rate limits and decline cooldowns, keyed by
/// purpose and subject: a public id, or a salted hash of an IP (never the IP).
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime

  @@index([windowStart])
}
